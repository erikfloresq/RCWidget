        }
      }
    },
    "El quarter (Q) se calcula automáticamente según el mes de inicio del sprint (Q1 ene–mar, Q2 abr–jun, Q3 jul–sep, Q4 oct–dic). El sprint avanza solo cuando su rango vence." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The quarter (Q) is computed automatically from the sprint's start month (Q1 Jan–Mar, Q2 Apr–Jun, Q3 Jul–Sep, Q4 Oct–Dec). The sprint advances on its own when its range ends."
          }
        }
      }
    },
    "En curso" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In progress"
          }
        }
      }
    },
